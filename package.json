{
	"name": "systemobserverwidget",
	"description": "A system observer widget for Windows",
	"author": {
		"name": "Kobaru",
		"email": "ikobakitsune@gmail.com"
	},
	"version": "1.0.0-alpha",
	"main": "dist/main.js",
	"type": "commonjs",
	"scripts": {
		"forge-start": "electron-forge start",
		"forge-make": "electron-forge make",
		"forge-pack": "electron-forge package",
		"start": "bun run build && electron .",
		"build": "bun run build-main && bun run build-renderer",
		"build-main": "tsc -p tsconfig.main.json",
		"build-renderer": "bun run build-components && bun run copy-index && bun run copy-static",
		"build-components": "cd src/Components && bun build ./**/*.ts --outdir ../../dist/Components --target browser --minify --external:electron",
		"copy-index": "cp src/index.html dist/index.html",
		"copy-static": "cpx \"static/**/*\" dist",
		"check": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@electron-forge/cli": "^7.8.0",
		"@electron-forge/maker-squirrel": "^7.8.0",
		"@electron-forge/maker-zip": "^7.8.0",
		"@kobaru/eslint-prettier-config": "file:../eslint-prettier-config",
		"@types/bun": "latest",
		"@types/node": "^22.15.3",
		"@typescript-eslint/eslint-plugin": "^8.31.1",
		"@typescript-eslint/parser": "^8.31.1",
		"cpx": "^1.5.0",
		"electron": "^36.0.0",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-prettier": "^5.2.6",
		"prettier": "^3.5.3"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"lit": "^3.3.0",
		"systeminformation": "^5.25.11"
	},
	"trustedDependencies": [
		"electron",
		"unrs-resolver"
	]
}
