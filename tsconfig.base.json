{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "node",
		"lib": ["DOM", "ESNext"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": true,
		"emitDecoratorMetadata": false,
		"allowJs": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"@kobaru/eslint-prettier-config": ["node_modules/@kobaru/eslint-prettier-config"]
		}
	}
}
